
import numpy as np

import pandas as pd

from sklearn.preprocessing import StandardScaler
from sklearn.base import clone

from sklearn.linear_model import LogisticRegression

from sklearn.tree import DecisionTreeClassifier

from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier

from sklearn.neighbors import KNeighborsClassifier

from sklearn.svm import SVC

from sklearn.metrics import (

    accuracy_score,

    precision_score,

    recall_score,

    f1_score,

    confusion_matrix

)

files = [

    "E0.csv",

    "E0 (2).csv",

    "E0 (3).csv",

    "E0 (4).csv",

    "E0 (5).csv"

]

dfs = []

for file in files:

    temp = pd.read_csv(file)

    temp = temp[

        [

            "Date",

            "HomeTeam",

            "AwayTeam",

            "FTHG",

            "FTAG",

            "FTR"

        ]

    ]

    dfs.append(temp)

df = pd.concat(

    dfs,

    ignore_index=True

)

df["Date"] = pd.to_datetime(

    df["Date"],

    dayfirst=True,

    errors="coerce"

)

df["FTHG"] = pd.to_numeric(

    df["FTHG"],

    errors="coerce"

)

df["FTAG"] = pd.to_numeric(

    df["FTAG"],

    errors="coerce"

)

df = df.dropna(

    subset=[

        "Date",

        "HomeTeam",

        "AwayTeam",

        "FTHG",

        "FTAG",

        "FTR"

    ]

)

df = df.sort_values(

    "Date"

).reset_index(drop=True)

elo = {}

history = {}

teams = pd.concat(

    [

        df["HomeTeam"],

        df["AwayTeam"]

    ]

).unique()

for team in teams:

    elo[team] = 1500

    history[team] = []

def get_last5_goal_difference(team):

    last5 = history[team][-5:]

    if len(last5) == 0:

        return 0

    return np.mean(

        [

            match["goal_diff"]

            for match in last5

        ]

    )

def update_elo(

    home,

    away,

    result

):

    home_elo = elo[home]

    away_elo = elo[away]

    expected_home = (

        1 /

        (

            1 +

            10 ** (

                (away_elo - home_elo) / 400

            )

        )

    )

    if result == "H":

        actual_home = 1

    elif result == "D":

        actual_home = 0.5

    else:

        actual_home = 0

    k = 20

    elo[home] = (

        home_elo +

        k *

        (

            actual_home -

            expected_home

        )

    )

    elo[away] = (

        away_elo +

        k *

        (

            (1 - actual_home) -

            (1 - expected_home)

        )

    )

rows = []

for _, row in df.iterrows():

    home = row["HomeTeam"]

    away = row["AwayTeam"]

    if (

        len(history[home]) >= 5

        and

        len(history[away]) >= 5

    ):

        home_elo = elo[home]

        away_elo = elo[away]

        home_goal_diff = (

            get_last5_goal_difference(home)

        )

        away_goal_diff = (

            get_last5_goal_difference(away)

        )

        rows.append(

            {

                "HomeELO": home_elo,

                "AwayELO": away_elo,

                "ELO_Diff":

                    home_elo - away_elo,

                "Home_GoalDiff_Last5":

                    home_goal_diff,

                "Away_GoalDiff_Last5":

                    away_goal_diff,

                "GoalDiff_Diff":

                    home_goal_diff -

                    away_goal_diff,

                "Target":

                    row["FTR"]

            }

        )

    home_goal_diff = (

        row["FTHG"] -

        row["FTAG"]

    )

    away_goal_diff = (

        row["FTAG"] -

        row["FTHG"]

    )

    history[home].append(

        {

            "goal_diff":

                home_goal_diff

        }

    )

    history[away].append(

        {

            "goal_diff":

                away_goal_diff

        }

    )

    update_elo(

        home,

        away,

        row["FTR"]

    )

data = pd.DataFrame(rows)

X = data[

    [

        "HomeELO",

        "AwayELO",

        "ELO_Diff",

        "Home_GoalDiff_Last5",

        "Away_GoalDiff_Last5",

        "GoalDiff_Diff"

    ]

]

y = data["Target"]

if len(data) < 30:
    raise ValueError("At least 30 historical matches with valid rolling features are required.")

# Chronological holdout: train on the earliest 70%, select on the next 15%,
# and keep the latest 15% untouched until final evaluation.
train_end = int(len(data) * 0.70)
validation_end = int(len(data) * 0.85)

X_train = X.iloc[:train_end].copy()
X_validation = X.iloc[train_end:validation_end].copy()
X_test = X.iloc[validation_end:].copy()
y_train = y.iloc[:train_end].copy()
y_validation = y.iloc[train_end:validation_end].copy()
y_test = y.iloc[validation_end:].copy()

scaled_model_names = {"Logistic Regression", "KNN", "SVM"}
train_scaler = StandardScaler()
X_train_scaled = train_scaler.fit_transform(X_train)
X_validation_scaled = train_scaler.transform(X_validation)
X_test_scaled = train_scaler.transform(X_test)

models = {
    "Logistic Regression": LogisticRegression(max_iter=1000),
    "Decision Tree": DecisionTreeClassifier(
        max_depth=5, min_samples_leaf=10, random_state=42
    ),
    "Random Forest": RandomForestClassifier(
        n_estimators=300, max_depth=8, min_samples_leaf=5, random_state=42
    ),
    "Gradient Boosting": GradientBoostingClassifier(
        n_estimators=200, learning_rate=0.05, max_depth=3, random_state=42
    ),
    "KNN": KNeighborsClassifier(n_neighbors=15),
    "SVM": SVC(kernel="rbf", probability=True, random_state=42),
}

validation_results = []
validation_models = {}
for name, estimator in models.items():
    model = clone(estimator)
    if name in scaled_model_names:
        train_data, validation_data = X_train_scaled, X_validation_scaled
    else:
        train_data, validation_data = X_train, X_validation

    model.fit(train_data, y_train)
    validation_predictions = model.predict(validation_data)
    validation_results.append({
        "Model": name,
        "Validation Accuracy": accuracy_score(y_validation, validation_predictions),
        "Validation Precision": precision_score(
            y_validation, validation_predictions, average="weighted", zero_division=0
        ),
        "Validation Recall": recall_score(
            y_validation, validation_predictions, average="weighted", zero_division=0
        ),
        "Validation F1": f1_score(
            y_validation, validation_predictions, average="weighted", zero_division=0
        ),
    })
    validation_models[name] = model

results_df = pd.DataFrame(validation_results).sort_values(
    "Validation F1", ascending=False
).reset_index(drop=True)
print("\\nMODEL COMPARISON (CHRONOLOGICAL VALIDATION)")
print(results_df.to_string(index=False))

best_model_name = results_df.iloc[0]["Model"]
selected_model = validation_models[best_model_name]
if best_model_name in scaled_model_names:
    test_data = X_test_scaled
else:
    test_data = X_test
test_predictions = selected_model.predict(test_data)

print("\\nSELECTED MODEL:", best_model_name)
print("HELD-OUT TEST METRICS")
print("Accuracy:", accuracy_score(y_test, test_predictions))
print("Precision:", precision_score(
    y_test, test_predictions, average="weighted", zero_division=0
))
print("Recall:", recall_score(
    y_test, test_predictions, average="weighted", zero_division=0
))
print("F1:", f1_score(
    y_test, test_predictions, average="weighted", zero_division=0
))
print("\\nHELD-OUT CONFUSION MATRIX")
print(confusion_matrix(y_test, test_predictions, labels=["H", "D", "A"]))

# Refit the selected model on all historical development data for future fixtures.
X_development = X.iloc[:validation_end]
y_development = y.iloc[:validation_end]
scaler = StandardScaler()
if best_model_name in scaled_model_names:
    development_data = scaler.fit_transform(X_development)
else:
    development_data = X_development
best_model = clone(models[best_model_name])
best_model.fit(development_data, y_development)

def predict_match(

    home,

    away

):

    if home not in elo:

        print(

            "Home team not found:",

            home

        )

        return

    if away not in elo:

        print(

            "Away team not found:",

            away

        )

        return

    home_elo = elo[home]

    away_elo = elo[away]

    home_goal_diff = (

        get_last5_goal_difference(

            home

        )

    )

    away_goal_diff = (

        get_last5_goal_difference(

            away

        )

    )

    match_features = pd.DataFrame(

        [

            {

                "HomeELO": home_elo,

                "AwayELO": away_elo,

                "ELO_Diff":

                    home_elo -

                    away_elo,

                "Home_GoalDiff_Last5":

                    home_goal_diff,

                "Away_GoalDiff_Last5":

                    away_goal_diff,

                "GoalDiff_Diff":

                    home_goal_diff -

away_goal_diff
                }

        ]

    )

    if best_model_name in [

        "Logistic Regression",

        "KNN",

        "SVM"

    ]:

        match_scaled = scaler.transform(

            match_features

        )

        prediction = best_model.predict(

            match_scaled

        )

        probabilities = (

            best_model.predict_proba(

                match_scaled

            )

        )

    else:

        prediction = best_model.predict(

            match_features

        )

        probabilities = (

            best_model.predict_proba(

                match_features

            )

        )

    print("\nMATCH")

    print("=" * 70)

    print(

        home,

        "vs",

        away

    )

    print(

        "\nPrediction:",

        prediction[0]

    )

    print("\nProbabilities:")

    for team_result, probability in zip(

        best_model.classes_,

        probabilities[0]

    ):

        print(

            team_result,

            ":",

            round(

                probability * 100,

                2

            ),

            "%"

        )

    print("\nFEATURES")

    print(

        match_features.to_string(

            index=False

        )

    )

predict_match(

    "Liverpool",

    "Arsenal"
)